# ============================================================
#  Скопируй в .env и подставь свои значения.
#  Проверить, что всё работает: python -m tg_scoring.cli check
# ============================================================

# Ключ авторизации из личного кабинета developers.sber.ru.
# Длинная строка вида "MWJkNzQ4...==". Это УЖЕ base64(client_id:client_secret) —
# второй раз кодировать не надо. Показывается один раз при создании.
GIGACHAT_AUTH_KEY=

# GIGACHAT_API_PERS  — физлица (для хакатона это оно)
# GIGACHAT_API_B2B   — юрлица, пакеты токенов
# GIGACHAT_API_CORP  — юрлица, pay-as-you-go
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# Точный идентификатор посмотри командой `python -m tg_scoring.cli check` —
# она печатает список моделей, доступных именно твоему ключу.
GIGACHAT_MODEL=GigaChat-2-Pro

# Базовый адрес. С 17.07.2026 новые подключения идут на api.giga.chat.
# Если ты подключался раньше и работает старый адрес — раскомментируй
# GIGACHAT_API_URL ниже, он перебивает базовый.
GIGACHAT_BASE_URL=https://api.giga.chat
# GIGACHAT_API_URL=https://gigachat.devices.sberbank.ru/api/v1/chat/completions

# Проверка TLS. Сертификаты Сбера подписаны «Russian Trusted Root CA»
# (НУЦ Минцифры), которого нет в стандартном хранилище Windows и в certifi.
#   C:\path\russian_trusted_root_ca.crt — путь к сертификату (правильный путь)
#   true                                — если сертификат уже в системе
#   false                               — отключить проверку (ТОЛЬКО отладка)
# Скачать: https://gu-st.ru/content/lending/russian_trusted_root_ca_pem.crt
GIGACHAT_VERIFY_SSL=false

# --- параметры пайплайна (можно не трогать) ---
RULESET_VERSION=1.0.0
CHUNK_SIZE=40
LLM_TEMPERATURE=0.1
LLM_TOP_P=0.1
LLM_MAX_RETRIES=1
LLM_TIMEOUT_S=60

# Доля сообщений без маркеров, которые всё равно уходят в LLM.
# Нужна для замера полноты словаря маркеров — не выключай.
PREFILTER_CONTROL_RATIO=0.10
PREFILTER_SEED=42

# Порог, ниже которого модуль отвечает insufficient_data вместо оценки.
# Считается по числу сообщений ПОСЛЕ очистки, не до неё.
MIN_MESSAGES_FOR_VERDICT=10

# Сколько сообщений считается «полными данными».
# coverage = min(1, sqrt(N / это_число]) и умножается на готовую дельту.
# Эти две ручки работают в паре, и вторая важнее первой: при 150 и
# десятке сообщений модуль ответит ok, но дельта усохнет в четыре раза
# (sqrt(10/150) = 0.26) — то есть выдаст почти ноль и будет выглядеть
# сломанным. Для тестов на маленьких файлах ставь сюда 20-30.
#
# Перед защитой и в проде верни 150: множитель существует затем, чтобы
# человек с двумя десятками сообщений не получал те же ±25, что человек
# с шестьюстами.
COVERAGE_TARGET_MESSAGES=150

# --- строгость оценки ---
# Крутить в таком порядке; после каждого шага проверяй на золотой выборке,
# а не на одном пользователе.
#
# 1) TANH_SCALE — главная ручка. delta = 25 * tanh(сырая_сумма / TANH_SCALE).
#    Меньше значение = круче кривая = та же разметка даёт большую дельту.
#    Пропорции между категориями не едут, меняется общий масштаб.
#    20 — по умолчанию, 12 — заметно строже, 8 — очень строго.
TANH_SCALE=20

# 2) SATURATION_K — как быстро категория набирает полный вес.
#    sat = 1 - exp(-n_eff / K). Меньше K = хватает меньшего числа
#    упоминаний. 3 — по умолчанию, 2 — строже.
SATURATION_K=3

# 3) Пороги уверенности. Ниже порог = принимается больше сигналов, но
#    растёт доля ложных. Негативный намеренно выше позитивного: ложный
#    минус бьёт по человеку сильнее ложного плюса.
MIN_CONFIDENCE_POSITIVE=0.60
MIN_CONFIDENCE_NEGATIVE=0.70

# Подобрать всё это без трат токенов:
#   python -m tg_scoring.cli run вход.json -o out.json --dump-signals sig.json
#   python -m tg_scoring.cli tune sig.json --messages 150

# Опциональные слои
PII_USE_NER=false
PREFILTER_USE_VECTORS=false
